# Copier en .env (jamais commité) et remplir.

# --- Accès admin de l'interface (ajout / suppression / restauration) ---
ADMIN_PASSWORD=

# --- Base RAG ---
POSTGRES_PASSWORD=ragpass

# --- Sources de tickets (laisser vide pour désactiver une source) ---
ERP_DATABASE_URL=
MANTIS_DB_HOST=mantis-testlink.ice.local
MANTIS_DB_PORT=3306
MANTIS_DB_NAME=m-pccn
MANTIS_DB_USER=rag-tickets
MANTIS_DB_PASSWORD=

# --- LLM ---
DEVSTRAL_BASE_URL=http://icechat.ice.local/v1-devstral
DEVSTRAL_MODEL=ollama/devstral-local

# --- Modèle d'embedding ---
# Défaut : bge-m3 (568M paramètres, ~2,5 Go de RAM par processus en float32)
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_POOLING=cls
EMBED_MAX_TOKENS=512
EMBED_BATCH_SIZE=8
# EMBED_THREADS=4
# EMBED_DTYPE=bfloat16   # RAM divisée par 2 ; ne l'activer que si le CPU gère bien le bf16
#
# Si la RAM est vraiment trop juste (~1,2 Go), alternative plus légère.
# ATTENTION : changer de modèle = changer EMBED_DIM = nouvelle migration + réindexation complète.
# EMBED_MODEL=intfloat/multilingual-e5-base
# EMBED_DIM=768
# EMBED_POOLING=mean
# EMBED_QUERY_PREFIX="query: "
# EMBED_DOC_PREFIX="passage: "

# --- OCR des pages scannées (ingestion) ---
OCR_ENABLED=1
OCR_LANG=fra+eng
